{
  "name": "furniture-viewer",
  "version": "1.0.0",
  "description": "3D viewer for board furniture (cabinets, wardrobes) with layers, exploded view, part codes and a GitHub-backed project library.",
  "scripts": {
    "dev": "npm run build:models && vite",
    "build": "npm run build:models && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ruby": "ruby tools/import-rb/test_classify.rb && ruby tools/import-rb/test_export.rb",
    "import:rb": "tsx tools/import-rb/import.ts",
    "build:models": "tsx tools/build-models.ts"
  },
  "dependencies": {
    "three": "^0.169.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/three": "^0.169.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "private": true,
  "type": "module"
}
